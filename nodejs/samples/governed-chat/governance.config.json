{
  "ledger": {
    "type": "localFile",
    "pathTemplate": ".copilot-state/governance/evidence.jsonl"
  },
  "mcpServers": {
    "internal-docs": {
      "type": "stdio",
      "command": "node",
      "args": [
        "internal-docs-mcp-server.mjs"
      ],
      "tools": [
        "search_internal_docs",
        "get_sales_data"
      ]
    }
  },
  "models": {
    "providers": {
      "github": {
        "type": "github",
        "models": {
          "gpt-4.1": {
            "id": "${PUBLIC_COPILOT_MODEL:-gpt-4.1}"
          }
        }
      },
      "local-mistral": {
        "type": "openai",
        "baseUrl": "${LOCAL_MISTRAL_BASE_URL:-http://localhost:11434/v1}",
        "apiKey": "${LOCAL_MISTRAL_API_KEY:-ollama}",
        "models": {
          "mistral": {
            "id": "local-mistral/${LOCAL_MISTRAL_MODEL:-mistral:latest}",
            "providerModelId": "${LOCAL_MISTRAL_MODEL:-mistral:latest}",
            "modelId": "${LOCAL_MISTRAL_MODEL:-mistral:latest}",
            "wireModel": "${LOCAL_MISTRAL_WIRE_MODEL:-mistral:latest}",
            "maxPromptTokens": 8192,
            "maxContextWindowTokens": 16384,
            "maxOutputTokens": 1024,
            "name": "Local Mistral"
          }
        }
      },
      "foundry": {
        "type": "azure",
        "wireApi": "responses",
        "baseUrl": "${FOUNDRY_BASE_URL:-}",
        "apiKey": "${FOUNDRY_API_KEY:-}",
        "azure": {
          "apiVersion": "${FOUNDRY_API_VERSION:-}"
        },
        "models": {
          "gpt-5.5": {
            "id": "foundry/${FOUNDRY_MODEL:-}",
            "providerModelId": "${FOUNDRY_MODEL:-}",
            "modelId": "gpt-4.1",
            "wireModel": "${FOUNDRY_DEPLOYMENT:-}",
            "maxPromptTokens": 65536,
            "maxContextWindowTokens": 131072,
            "maxOutputTokens": 4096,
            "name": "Foundry GPT-5.5"
          }
        }
      }
    }
  },
  "executionEnvironments": {
    "public-github": {
      "models": {
        "allow": ["github/*"],
        "deny": ["local-mistral/*", "foundry/gpt-5.5"]
      },
      "tools": {
        "deny": []
      },
      "mcpServers": {
        "deny": []
      }
    },
    "internal-foundry": {
      "models": {
        "allow": ["foundry/gpt-5.5"],
        "deny": ["github/gpt-4.1", "local-mistral/*"]
      },
      "tools": {
        "deny": []
      },
      "mcpServers": {
        "deny": []
      }
    },
    "confidential-foundry": {
      "models": {
        "allow": ["foundry/gpt-5.5"],
        "deny": ["github/gpt-4.1", "local-mistral/*"]
      },
      "tools": {
        "allow": [
          "builtin:ask_user",
          "builtin:task_complete",
          "builtin:exit_plan_mode",
          "builtin:task",
          "builtin:read_agent",
          "builtin:write_agent",
          "builtin:list_agents",
          "builtin:send_inbox",
          "builtin:context_board",
          "builtin:skill",
          "mcp:internal-docs-search_internal_docs",
          "mcp:internal-docs-get_sales_data"
        ]
      },
      "mcpServers": {
        "allow": ["internal-docs"]
      }
    }
  },
  "profiles": {
    "public": {
      "sensitivity": "public",
      "environment": "public-github",
      "upgradeTargets": ["internal", "confidential"]
    },
    "internal": {
      "sensitivity": "internal",
      "environment": "internal-foundry",
      "upgradeTargets": ["confidential"]
    },
    "confidential": {
      "sensitivity": "confidential",
      "environment": "confidential-foundry"
    }
  }
}